<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- [L3] Microphone access. Harmless without the hardened runtime (dev builds), but REQUIRED
	     once the hardened runtime is enabled for Developer-ID notarization: without it,
	     AVAudioApplication.requestRecordPermission() returns false and voice dictation (panel +
	     main window) silently dies in the shipped build while working in every dev build. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
